# Server only. Never put provider secrets in VITE_ variables.
COMFY_API_KEY=
# Use an FFmpeg build with drawtext for server captions.
# VIRAL_HIT_FFMPEG=/absolute/path/to/full/ffmpeg
# VIRAL_HIT_DATA_DIR=/absolute/path/to/local-data
# Optional directory of locally installed JSON recipe manifests.
# VIRAL_HIT_RECIPES_DIR=/absolute/path/to/recipes

# Optional trusted execution modules. Absolute path; restart app, MCP and worker after changes.
# Recipes never install these modules. See docs/EXTERNAL-ADAPTERS.md.
# VIRAL_HIT_ADAPTERS_DIR=/absolute/path/to/reviewed-adapters

# Optional folder of your own agent skills (one folder per skill). See docs/SKILLS.md.
# VIRAL_HIT_SKILLS_DIR=/absolute/path/to/my-skills

# Server-only publishing account service; HTTP/UI callback integration is still pending.
# See docs/PUBLISHING.md before configuring. No account is connected automatically.
# VIRAL_HIT_GOOGLE_CLIENT_ID=
# VIRAL_HIT_GOOGLE_CLIENT_SECRET=
# VIRAL_HIT_GOOGLE_REDIRECT_URI=http://127.0.0.1:3808/api/app/publishing/youtube/callback
# Optional 32-byte key encoded as 64 hex characters; otherwise a private workspace key is created.
# VIRAL_HIT_PUBLISHING_KEY=

# Optional Instagram account connections (Facebook Login for Business, User token configuration).
# See docs/architecture/010-instagram-accounts.md for permissions and the Page-selection flow.
# VIRAL_HIT_META_APP_ID=
# VIRAL_HIT_META_APP_SECRET=
# VIRAL_HIT_META_LOGIN_CONFIG_ID=
# VIRAL_HIT_META_REDIRECT_URI=http://127.0.0.1:3808/api/app/publishing/instagram/callback

# Optional source acquisition CLI; no .NET dependency is installed with Studio.
# See docs/REFERENCE-INTAKE.md and extensions/youtube-intake/README.md.
# VIRAL_HIT_YOUTUBE_ENGINE=/absolute/path/to/YoutubeIntake.dll
# VIRAL_HIT_DOTNET=/absolute/path/to/dotnet
# VIRAL_HIT_FFPROBE=/absolute/path/to/ffprobe
