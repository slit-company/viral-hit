{
  "$comment": "Kiro — copy to ~/.kiro/settings/mcp.json (global) or .kiro/settings/mcp.json in the project. Kiro uses the standard mcpServers object for local stdio servers.",
  "mcpServers": {
    "viral-hit": {
      "command": "/absolute/path/to/viral-hit/apps/studio/node_modules/.bin/tsx",
      "args": ["/absolute/path/to/viral-hit/apps/studio/scripts/mcp-server.ts"],
      "disabled": false,
      "autoApprove": []
    }
  }
}
