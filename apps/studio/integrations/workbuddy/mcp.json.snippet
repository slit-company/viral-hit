{
  "$comment": "WorkBuddy manual setup — start pnpm dev:agent in ViralHit, then merge this entry into ~/.workbuddy/mcp.json. For marketplace packaging, use integrations/workbuddy/viral-hit instead.",
  "mcpServers": {
    "viral-hit": {
      "type": "streamableHttp",
      "url": "http://127.0.0.1:3031/mcp",
      "timeout": 30000,
      "description": "ViralHit local-first AI canvas (Cloud API). Open http://127.0.0.1:3020 for the browser view."
    }
  }
}
