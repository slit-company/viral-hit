{
  "$comment": "Cline / Roo Code (VS Code extensions) — copy to ~/.cline/mcp_settings.json (global) or .cline/mcp_settings.json in the project. Roo Code uses .roo/mcp_settings.json with the same shape.",
  "mcpServers": {
    "viral-hit": {
      "command": "/absolute/path/to/viral-hit/apps/studio/node_modules/.bin/tsx",
      "args": ["/absolute/path/to/viral-hit/apps/studio/scripts/mcp-server.ts"],
      "env": {},
      "disabled": false,
      "autoApprove": []
    }
  }
}
