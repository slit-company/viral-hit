{
  "$comment": "Windsurf — copy to ~/.codeium/windsurf/mcp_config.json (global) or .codeium/windsurf/mcp_config.json in the project. Same mcpServers shape as Cursor.",
  "mcpServers": {
    "viral-hit": {
      "command": "/absolute/path/to/viral-hit/apps/studio/node_modules/.bin/tsx",
      "args": ["/absolute/path/to/viral-hit/apps/studio/scripts/mcp-server.ts"],
      "env": {}
    }
  }
}
