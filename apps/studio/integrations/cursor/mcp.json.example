{
  "$comment": "Cursor — copy to .cursor/mcp.json in the project (team/project scope) or ~/.cursor/mcp.json (global). The stdio type is explicit for current Cursor schemas; there is no cwd field, so the ViralHit entry script repairs the working directory itself.",
  "mcpServers": {
    "viral-hit": {
      "type": "stdio",
      "command": "/absolute/path/to/viral-hit/apps/studio/node_modules/.bin/tsx",
      "args": ["/absolute/path/to/viral-hit/apps/studio/scripts/mcp-server.ts"],
      "env": {}
    }
  }
}
