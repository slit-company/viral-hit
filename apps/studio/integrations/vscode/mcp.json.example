{
  "$comment": "VS Code (native Copilot Agent MCP) — copy to .vscode/mcp.json in the project. VS Code uses a 'servers' key instead of 'mcpServers'. Users must approve the workspace MCP server the first time.",
  "servers": {
    "viral-hit": {
      "type": "stdio",
      "command": "/absolute/path/to/viral-hit/apps/studio/node_modules/.bin/tsx",
      "args": ["/absolute/path/to/viral-hit/apps/studio/scripts/mcp-server.ts"],
      "env": {}
    }
  }
}
