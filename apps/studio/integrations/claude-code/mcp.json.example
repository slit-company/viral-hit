{
  "$comment": "Claude Code — merge the mcpServers entry into .mcp.json in the project or ~/.claude.json for user scope. Claude Code supports local stdio servers; the entry script repairs a foreign working directory.",
  "mcpServers": {
    "viral-hit": {
      "command": "/absolute/path/to/viral-hit/apps/studio/node_modules/.bin/tsx",
      "args": ["/absolute/path/to/viral-hit/apps/studio/scripts/mcp-server.ts"]
    }
  }
}
