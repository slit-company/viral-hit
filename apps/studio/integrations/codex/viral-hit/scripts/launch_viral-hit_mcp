#!/bin/sh
set -eu

launcher_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
plugin_root=$(CDPATH= cd -- "$launcher_dir/.." && pwd)
workspace_root=${VIRAL_HIT_ROOT:-}

if [ -z "$workspace_root" ]; then
  workspace_root=$(CDPATH= cd -- "$plugin_root/../../.." && pwd)
fi

if [ ! -f "$workspace_root/package.json" ]; then
  echo "ViralHit root not found. Set VIRAL_HIT_ROOT to the cloned repository path." >&2
  exit 1
fi

tsx_cli="$workspace_root/node_modules/tsx/dist/cli.mjs"
if [ ! -f "$tsx_cli" ]; then
  echo "ViralHit dependencies are missing. Run pnpm install in VIRAL_HIT_ROOT." >&2
  exit 1
fi

# Codex may start a plugin without the user's interactive shell PATH. Prefer
# an explicit absolute Node path when provided, then fall back to the host
# PATH. Invoking tsx's CLI through Node avoids the .bin/tsx shell wrapper.
node_bin=${VIRAL_HIT_NODE:-}
if [ -z "$node_bin" ]; then
  node_bin=$(command -v node 2>/dev/null || true)
fi
if [ -z "$node_bin" ]; then
  echo "Node.js was not found. Set VIRAL_HIT_NODE to the absolute Node executable path." >&2
  exit 1
fi

# tsx resolves tsconfig.json (for the @/* path aliases) and the app resolves
# data/ paths relative to the working directory, so the server must always
# run from the repository root regardless of the host's working directory.
cd -- "$workspace_root"

exec "$node_bin" "$tsx_cli" "$workspace_root/scripts/mcp-server.ts"
