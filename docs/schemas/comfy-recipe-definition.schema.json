{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "tags": {
      "default": [],
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,79}$"
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "field": {
          "type": "string",
          "enum": [
            "images",
            "audio",
            "gifs",
            "videos"
          ]
        },
        "index": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "kind": {
          "type": "string",
          "enum": [
            "image",
            "video",
            "audio"
          ]
        }
      },
      "required": [
        "nodeId",
        "field",
        "index",
        "kind"
      ],
      "additionalProperties": false
    },
    "parameters": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "parameter": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,79}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "type": {
                    "type": "string",
                    "const": "asset"
                  },
                  "kind": {
                    "type": "string",
                    "const": "image"
                  },
                  "default": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,128}$"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "type",
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,79}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "type": {
                    "type": "string",
                    "const": "string"
                  },
                  "multiline": {
                    "type": "boolean"
                  },
                  "default": {
                    "type": "string",
                    "maxLength": 16000
                  },
                  "minLength": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16000
                  },
                  "maxLength": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16000
                  }
                },
                "required": [
                  "id",
                  "label",
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,79}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "type": {
                    "type": "string",
                    "const": "number"
                  },
                  "default": {
                    "type": "number"
                  },
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "integer": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,79}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "type": {
                    "type": "string",
                    "const": "boolean"
                  },
                  "default": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,79}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "type": {
                    "type": "string",
                    "const": "enum"
                  },
                  "options": {
                    "minItems": 1,
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "default": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "type",
                  "options"
                ],
                "additionalProperties": false
              }
            ]
          },
          "targets": {
            "minItems": 1,
            "maxItems": 128,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "nodeId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "input": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "nodeId",
                "input"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "parameter",
          "targets"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "description",
    "license",
    "author",
    "category",
    "tags",
    "output",
    "parameters"
  ],
  "additionalProperties": false
}
