{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "scope": {
      "type": "string",
      "enum": [
        "general",
        "specialized"
      ]
    },
    "useCases": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,79}$"
      }
    },
    "homepage": {
      "type": "string",
      "maxLength": 300,
      "format": "uri"
    },
    "requirements": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "viral-hit-creative-pack"
    },
    "recipes": {
      "maxItems": 24,
      "type": "array",
      "items": {}
    },
    "skills": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "number",
            "const": 1
          },
          "kind": {
            "type": "string",
            "const": "viral-hit-skill"
          },
          "manifest": {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "number",
                "const": 1
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "scope": {
                "default": "general",
                "type": "string",
                "enum": [
                  "general",
                  "specialized"
                ]
              },
              "author": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "license": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "visibility": {
                "default": "showcase",
                "type": "string",
                "enum": [
                  "showcase",
                  "hidden"
                ]
              },
              "compatibility": {
                "type": "object",
                "properties": {
                  "minimumViralHitVersion": {
                    "type": "string",
                    "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
                  },
                  "requiredMcpTools": {
                    "default": [],
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^viral_hit_[a-z0-9_]+$"
                    }
                  }
                },
                "required": [
                  "minimumViralHitVersion"
                ],
                "additionalProperties": false
              },
              "requiredCapabilities": {
                "default": [],
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "inputs": {
                "default": [],
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "text",
                        "image",
                        "video",
                        "audio",
                        "number",
                        "boolean"
                      ]
                    },
                    "required": {
                      "default": true,
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "description",
                    "kind"
                  ],
                  "additionalProperties": false
                }
              },
              "stages": {
                "default": [],
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "reviewRequired": {
                      "default": false,
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "description"
                  ],
                  "additionalProperties": false
                }
              },
              "showcase": {
                "type": "object",
                "properties": {
                  "category": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "tags": {
                    "default": [],
                    "maxItems": 12,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    }
                  },
                  "featured": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": [
                  "category"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "schemaVersion",
              "id",
              "version",
              "title",
              "summary",
              "compatibility"
            ],
            "additionalProperties": false
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 524288
          }
        },
        "required": [
          "schemaVersion",
          "kind",
          "manifest",
          "instructions"
        ],
        "additionalProperties": false
      }
    },
    "characters": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "number",
            "const": 1
          },
          "kind": {
            "type": "string",
            "const": "viral-hit-character"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "profile": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "kind": {
                "type": "string",
                "enum": [
                  "person",
                  "illustrated",
                  "mascot",
                  "product",
                  "other"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "invariants": {
                "default": [],
                "maxItems": 24,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "forbidden": {
                "default": [],
                "maxItems": 24,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "providerIdentities": {
                "default": [],
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{1,40}$"
                    },
                    "referenceId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 80
                    }
                  },
                  "required": [
                    "provider",
                    "referenceId"
                  ],
                  "additionalProperties": false
                }
              },
              "voice": {
                "type": "object",
                "properties": {
                  "direction": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "provider": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "voiceId": {
                    "type": "string",
                    "maxLength": 120
                  }
                },
                "required": [
                  "direction"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "name",
              "kind",
              "description"
            ],
            "additionalProperties": false
          },
          "references": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "canonical",
                    "angle",
                    "expression",
                    "outfit",
                    "detail"
                  ]
                },
                "filename": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "mimeType": {
                  "type": "string",
                  "enum": [
                    "image/png",
                    "image/jpeg",
                    "image/webp"
                  ]
                },
                "width": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "height": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "note": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": [
                "sha256",
                "role",
                "filename",
                "mimeType",
                "width",
                "height"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "schemaVersion",
          "kind",
          "id",
          "profile",
          "references"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "version",
    "title",
    "description",
    "author",
    "license",
    "scope",
    "useCases",
    "schemaVersion",
    "kind",
    "recipes",
    "skills",
    "characters"
  ],
  "additionalProperties": false
}
