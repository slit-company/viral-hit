{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "viral-hit-provider"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,39}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "scope": {
      "default": "general",
      "type": "string",
      "enum": [
        "general",
        "specialized"
      ]
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "referenceDelivery": {
      "type": "string",
      "const": "project-media"
    },
    "configurationDelivery": {
      "type": "string",
      "const": "request"
    },
    "connectionTest": {
      "type": "boolean"
    },
    "balanceCheck": {
      "type": "boolean"
    },
    "setupUrl": {
      "type": "string",
      "maxLength": 300,
      "format": "uri"
    },
    "keyFormat": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "entry": {
      "default": "provider.mjs",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.m?js$"
    },
    "mediaHosts": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:[a-z0-9-]+\\.)*[a-z0-9-]+(?::\\d{1,5})?$"
      }
    },
    "environment": {
      "default": [],
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{0,100}$"
      }
    },
    "models": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "type": "string",
            "enum": [
              "image",
              "video",
              "audio",
              "analysis"
            ]
          },
          "controls": {
            "minItems": 1,
            "maxItems": 16,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,39}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 300
                    },
                    "type": {
                      "type": "string",
                      "const": "string"
                    },
                    "default": {
                      "type": "string",
                      "maxLength": 4000
                    },
                    "maxLength": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4000
                    },
                    "multiline": {
                      "type": "boolean"
                    },
                    "suggestions": {
                      "minItems": 1,
                      "maxItems": 48,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 120
                          },
                          "label": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80
                          }
                        },
                        "required": [
                          "value",
                          "label"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "key",
                    "label",
                    "type",
                    "default",
                    "maxLength"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,39}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 300
                    },
                    "type": {
                      "type": "string",
                      "const": "number"
                    },
                    "default": {
                      "type": "number"
                    },
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "integer": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "key",
                    "label",
                    "type",
                    "default",
                    "min",
                    "max"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,39}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 300
                    },
                    "type": {
                      "type": "string",
                      "const": "boolean"
                    },
                    "default": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "key",
                    "label",
                    "type",
                    "default"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,39}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 300
                    },
                    "type": {
                      "type": "string",
                      "const": "select"
                    },
                    "default": {
                      "type": "string",
                      "maxLength": 120
                    },
                    "choices": {
                      "minItems": 1,
                      "maxItems": 32,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 120
                          },
                          "label": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80
                          }
                        },
                        "required": [
                          "value",
                          "label"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "key",
                    "label",
                    "type",
                    "default",
                    "choices"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "studioTasks": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "image-generate",
                "image-edit",
                "relight",
                "text-edit",
                "remove-background",
                "image-upscale",
                "video-generate",
                "video-edit",
                "motion-control",
                "motion-transfer",
                "object-swap",
                "restyle",
                "image-lipsync",
                "video-lipsync",
                "text-to-speech",
                "voice-change",
                "audio-generate",
                "music-generate",
                "video-caption",
                "video-dubbing",
                "video-upscale",
                "media-analysis"
              ]
            }
          },
          "analysisInputs": {
            "type": "object",
            "properties": {
              "image": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  }
                },
                "required": [
                  "min",
                  "max"
                ],
                "additionalProperties": false
              },
              "video": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  }
                },
                "required": [
                  "min",
                  "max"
                ],
                "additionalProperties": false
              },
              "audio": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  }
                },
                "required": [
                  "min",
                  "max"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "image",
              "video",
              "audio"
            ],
            "additionalProperties": false
          },
          "referenceInputs": {
            "type": "object",
            "properties": {
              "image": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  }
                },
                "required": [
                  "min",
                  "max"
                ],
                "additionalProperties": false
              },
              "video": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  }
                },
                "required": [
                  "min",
                  "max"
                ],
                "additionalProperties": false
              },
              "audio": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  }
                },
                "required": [
                  "min",
                  "max"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "image",
              "video",
              "audio"
            ],
            "additionalProperties": false
          },
          "videoImageInputs": {
            "type": "object",
            "properties": {
              "frames": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2
              },
              "references": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              }
            },
            "additionalProperties": false
          },
          "maskInput": {
            "type": "object",
            "properties": {
              "required": {
                "default": false,
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "promptInput": {
            "type": "string",
            "enum": [
              "optional",
              "none"
            ]
          },
          "referenceRoles": {
            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "style",
                "subject",
                "pose"
              ]
            }
          },
          "pricing": {
            "type": "object",
            "properties": {
              "currency": {
                "type": "string",
                "enum": [
                  "USD",
                  "characters"
                ]
              },
              "per": {
                "type": "string",
                "enum": [
                  "second",
                  "output",
                  "request",
                  "megapixel",
                  "character"
                ]
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 100000
              },
              "by": {
                "type": "object",
                "properties": {
                  "option": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                      },
                      {
                        "minItems": 2,
                        "maxItems": 3,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                        }
                      }
                    ]
                  },
                  "amounts": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    },
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100000
                    }
                  }
                },
                "required": [
                  "option",
                  "amounts"
                ],
                "additionalProperties": false
              },
              "minimum": {
                "type": "number",
                "minimum": 0,
                "maximum": 100000
              },
              "basis": {
                "default": "list",
                "type": "string",
                "enum": [
                  "list",
                  "average"
                ]
              },
              "source": {
                "type": "string",
                "maxLength": 300,
                "format": "uri"
              },
              "checked": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "required": [
              "currency",
              "per",
              "source",
              "checked"
            ],
            "additionalProperties": false
          },
          "upstreamModelId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "aspectRatios": {
            "default": [],
            "maxItems": 14,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "1:1",
                "16:9",
                "9:16",
                "4:3",
                "3:4",
                "3:2",
                "2:3",
                "4:5",
                "5:4",
                "21:9",
                "9:21",
                "2:1",
                "1:2",
                "auto"
              ]
            }
          },
          "defaultAspectRatio": {
            "type": "string",
            "enum": [
              "1:1",
              "16:9",
              "9:16",
              "4:3",
              "3:4",
              "3:2",
              "2:3",
              "4:5",
              "5:4",
              "21:9",
              "9:21",
              "2:1",
              "1:2",
              "auto"
            ]
          },
          "durations": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{1,2}s$"
            }
          },
          "defaultDuration": {
            "type": "string",
            "pattern": "^\\d{1,2}s$"
          },
          "maxReferenceImages": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 30
          },
          "requiresImageInput": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "label",
    "models"
  ],
  "additionalProperties": false
}
