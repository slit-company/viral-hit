{
  "schemaVersion": 1,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "author": "Viral Hit",
  "category": "self-hosted",
  "tags": [
    "comfyui",
    "image",
    "local"
  ],
  "id": "local-diffusion",
  "title": "Local diffusion",
  "description": "Run a checkpoint-based text-to-image graph on your own ComfyUI server. Requires a compatible checkpoint (for example SDXL) already installed. No weights or custom nodes are downloaded. Hardware and checkpoint determine quality and speed; this workflow has not been model-quality benchmarked.",
  "parameters": [
    {
      "id": "checkpoint",
      "label": "Installed checkpoint filename",
      "type": "string",
      "multiline": false,
      "minLength": 1,
      "maxLength": 500
    },
    {
      "id": "prompt",
      "label": "Describe the image",
      "type": "string",
      "minLength": 3,
      "maxLength": 16000
    },
    {
      "id": "negative",
      "label": "Negative prompt",
      "type": "string",
      "default": "",
      "minLength": 0
    },
    {
      "id": "width",
      "label": "Width (multiple of 8)",
      "type": "number",
      "integer": true,
      "default": 1024,
      "min": 64,
      "max": 2048
    },
    {
      "id": "height",
      "label": "Height (multiple of 8)",
      "type": "number",
      "integer": true,
      "default": 1024,
      "min": 64,
      "max": 2048
    },
    {
      "id": "seed",
      "label": "Seed",
      "type": "number",
      "integer": true,
      "default": 42,
      "min": 0,
      "max": 4294967295
    },
    {
      "id": "steps",
      "label": "Sampling steps",
      "type": "number",
      "integer": true,
      "default": 20,
      "min": 1,
      "max": 100
    },
    {
      "id": "cfg",
      "label": "Guidance scale",
      "type": "number",
      "default": 7,
      "min": 0,
      "max": 30
    }
  ],
  "nodes": [
    {
      "id": "workflow",
      "operation": "comfy.workflow",
      "version": "1",
      "cache": false,
      "input": {
        "workflow": {
          "1": {
            "class_type": "CheckpointLoaderSimple",
            "inputs": {
              "ckpt_name": ""
            }
          },
          "2": {
            "class_type": "CLIPTextEncode",
            "inputs": {
              "text": "",
              "clip": [
                "1",
                1
              ]
            }
          },
          "3": {
            "class_type": "CLIPTextEncode",
            "inputs": {
              "text": "",
              "clip": [
                "1",
                1
              ]
            }
          },
          "4": {
            "class_type": "EmptyLatentImage",
            "inputs": {
              "width": 1024,
              "height": 1024,
              "batch_size": 1
            }
          },
          "5": {
            "class_type": "KSampler",
            "inputs": {
              "model": [
                "1",
                0
              ],
              "positive": [
                "2",
                0
              ],
              "negative": [
                "3",
                0
              ],
              "latent_image": [
                "4",
                0
              ],
              "seed": 42,
              "steps": 20,
              "cfg": 7,
              "sampler_name": "euler",
              "scheduler": "normal",
              "denoise": 1
            }
          },
          "6": {
            "class_type": "VAEDecode",
            "inputs": {
              "samples": [
                "5",
                0
              ],
              "vae": [
                "1",
                2
              ]
            }
          },
          "7": {
            "class_type": "SaveImage",
            "inputs": {
              "images": [
                "6",
                0
              ],
              "filename_prefix": "Viral Hit/diffusion"
            }
          }
        },
        "output": {
          "nodeId": "7",
          "field": "images",
          "index": 0
        }
      },
      "parameters": [
        {
          "parameter": "checkpoint",
          "target": "/workflow/1/inputs/ckpt_name"
        },
        {
          "parameter": "prompt",
          "target": "/workflow/2/inputs/text"
        },
        {
          "parameter": "negative",
          "target": "/workflow/3/inputs/text"
        },
        {
          "parameter": "width",
          "target": "/workflow/4/inputs/width"
        },
        {
          "parameter": "height",
          "target": "/workflow/4/inputs/height"
        },
        {
          "parameter": "seed",
          "target": "/workflow/5/inputs/seed"
        },
        {
          "parameter": "steps",
          "target": "/workflow/5/inputs/steps"
        },
        {
          "parameter": "cfg",
          "target": "/workflow/5/inputs/cfg"
        }
      ]
    },
    {
      "id": "image",
      "operation": "asset.materialize",
      "version": "1",
      "cache": false,
      "input": {
        "receipt": null,
        "kind": "image",
        "label": "Local diffusion"
      },
      "dependsOn": [
        "workflow"
      ],
      "bindings": [
        {
          "node": "workflow",
          "pointer": "/binaryReceipt",
          "target": "/receipt"
        }
      ]
    }
  ]
}
