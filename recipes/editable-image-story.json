{
  "schemaVersion": 1,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "author": "Viral Hit contributors",
  "category": "editing",
  "tags": [
    "editable",
    "local",
    "sequence"
  ],
  "id": "editable-image-story",
  "title": "Build an editable image story",
  "description": "Turn a project image and title into separate editable clips. Add the completed sequence after your current timeline. Fork this manifest to add more shots or controls.",
  "parameters": [
    {
      "id": "image",
      "label": "Project image",
      "type": "asset",
      "kind": "image"
    },
    {
      "id": "title",
      "label": "Title",
      "type": "string",
      "multiline": false,
      "default": "MAKE IT YOURS",
      "maxLength": 80
    },
    {
      "id": "duration",
      "label": "Duration (seconds)",
      "type": "number",
      "default": 3,
      "min": 0.1,
      "max": 60
    }
  ],
  "nodes": [
    {
      "id": "edit",
      "operation": "editor.sequence",
      "version": "1",
      "input": {
        "schemaVersion": 1,
        "title": "Image story",
        "assets": {
          "image": {
            "assetId": "select-image",
            "kind": "image"
          }
        },
        "tracks": [
          {
            "id": "visual",
            "name": "Visual",
            "kind": "video",
            "clips": [
              {
                "id": "visual",
                "type": "media",
                "source": "image",
                "startTime": 0,
                "duration": 3
              }
            ]
          },
          {
            "id": "title",
            "name": "Title",
            "kind": "caption",
            "clips": [
              {
                "id": "title",
                "type": "caption",
                "startTime": 0,
                "duration": 3,
                "text": "MAKE IT YOURS"
              }
            ]
          }
        ]
      },
      "parameters": [
        {
          "parameter": "image",
          "target": "/assets/image/assetId"
        },
        {
          "parameter": "title",
          "target": "/tracks/1/clips/0/text"
        },
        {
          "parameter": "duration",
          "target": "/tracks/0/clips/0/duration"
        },
        {
          "parameter": "duration",
          "target": "/tracks/1/clips/0/duration"
        }
      ]
    }
  ]
}
