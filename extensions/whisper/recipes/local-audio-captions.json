{
  "schemaVersion": 1,
  "id": "local-transcription-audio-captions",
  "version": "1.0.0",
  "title": "Caption a recording with a cover image",
  "description": "Transcribe a selected range with your optional local Whisper engine, review machine-estimated text/timing and append an editable source with separate captions. An empty recognition result leaves the caption track empty. Model accuracy depends on language and recording; review before use. Up to 64 MiB and 120 seconds per run.",
  "author": "Viral Hit contributors",
  "license": "Apache-2.0",
  "category": "audio",
  "tags": [
    "speech",
    "captions",
    "local",
    "editing"
  ],
  "parameters": [
    {
      "id": "source",
      "label": "Source audio",
      "type": "asset",
      "kind": "audio"
    },
    {
      "id": "cover",
      "label": "Cover image",
      "type": "asset",
      "kind": "image"
    },
    {
      "id": "language",
      "label": "Spoken language code",
      "type": "string",
      "multiline": false,
      "default": "auto",
      "minLength": 2,
      "maxLength": 4,
      "description": "auto, en, ko, ja, and other codes supported by your selected model. English-only models require en."
    },
    {
      "id": "start",
      "label": "Start time (seconds)",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 3600
    },
    {
      "id": "duration",
      "label": "Maximum audio seconds",
      "type": "number",
      "default": 30,
      "min": 1,
      "max": 120
    },
    {
      "id": "length",
      "label": "Target caption length",
      "type": "number",
      "default": 72,
      "min": 16,
      "max": 160,
      "integer": true
    },
    {
      "id": "threads",
      "label": "CPU threads",
      "type": "number",
      "default": 2,
      "min": 1,
      "max": 4,
      "integer": true
    }
  ],
  "nodes": [
    {
      "id": "transcribe",
      "operation": "ext.whisper-transcribe",
      "version": "1",
      "cache": false,
      "input": {
        "videoAssetId": null,
        "audioAssetId": "",
        "language": "auto",
        "start": 0,
        "duration": 30,
        "maxChars": 72,
        "threads": 2
      },
      "parameters": [
        {
          "parameter": "source",
          "target": "/audioAssetId"
        },
        {
          "parameter": "language",
          "target": "/language"
        },
        {
          "parameter": "start",
          "target": "/start"
        },
        {
          "parameter": "duration",
          "target": "/duration"
        },
        {
          "parameter": "length",
          "target": "/maxChars"
        },
        {
          "parameter": "threads",
          "target": "/threads"
        }
      ]
    },
    {
      "id": "sequence",
      "operation": "editor.sequence",
      "version": "1",
      "cache": false,
      "dependsOn": [
        "transcribe"
      ],
      "input": {
        "schemaVersion": 1,
        "title": "Speech captions",
        "assets": {
          "source": {
            "assetId": "pending",
            "kind": "audio"
          },
          "cover": {
            "assetId": "pending",
            "kind": "image"
          }
        },
        "tracks": [
          {
            "id": "source-track",
            "kind": "audio",
            "name": "Original audio",
            "clips": [
              {
                "id": "source-clip",
                "type": "media",
                "source": "source",
                "startTime": 0,
                "duration": 1
              }
            ]
          },
          {
            "id": "spoken-captions",
            "kind": "caption",
            "name": "Editable speech captions",
            "clips": [
              {
                "id": "placeholder",
                "type": "caption",
                "text": "Pending recognition",
                "startTime": 0,
                "duration": 1
              }
            ]
          },
          {
            "id": "cover-track",
            "kind": "video",
            "name": "Cover",
            "clips": [
              {
                "id": "cover",
                "type": "media",
                "source": "cover",
                "startTime": 0,
                "duration": 1
              }
            ]
          }
        ]
      },
      "parameters": [
        {
          "parameter": "source",
          "target": "/assets/source/assetId"
        },
        {
          "parameter": "cover",
          "target": "/assets/cover/assetId"
        }
      ],
      "bindings": [
        {
          "target": "/tracks/0/clips",
          "node": "transcribe",
          "pointer": "/mediaClips"
        },
        {
          "target": "/tracks/1/clips",
          "node": "transcribe",
          "pointer": "/captionClips"
        },
        {
          "target": "/tracks/2/clips/0/duration",
          "node": "transcribe",
          "pointer": "/duration"
        }
      ]
    }
  ]
}
