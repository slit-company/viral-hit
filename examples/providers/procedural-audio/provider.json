{
  "schemaVersion": 1,
  "kind": "viral-hit-provider",
  "id": "procedural-audio",
  "label": "Procedural audio example",
  "description": "Dependency-free WAV generation to demonstrate independent audio models. This does not interpret prompts or synthesize speech.",
  "scope": "general",
  "author": "Viral Hit contributors",
  "license": "Apache-2.0",
  "models": [
    {
      "id": "procedural-sound",
      "name": "Procedural sound (instant)",
      "kind": "audio",
      "controls": [
        {
          "key": "frequency",
          "label": "Frequency (Hz)",
          "type": "number",
          "min": 80,
          "max": 2000,
          "default": 330
        },
        {
          "key": "seconds",
          "label": "Length (seconds)",
          "type": "number",
          "min": 0.1,
          "max": 10,
          "default": 1
        },
        {
          "key": "wave",
          "label": "Wave shape",
          "type": "select",
          "default": "sine",
          "choices": [
            {
              "value": "sine",
              "label": "Sine"
            },
            {
              "value": "triangle",
              "label": "Triangle"
            }
          ]
        }
      ]
    },
    {
      "id": "procedural-sound-queued",
      "name": "Procedural sound (queued)",
      "kind": "audio",
      "controls": [
        {
          "key": "frequency",
          "label": "Frequency (Hz)",
          "type": "number",
          "min": 80,
          "max": 2000,
          "default": 330
        },
        {
          "key": "seconds",
          "label": "Length (seconds)",
          "type": "number",
          "min": 0.1,
          "max": 10,
          "default": 1
        },
        {
          "key": "wave",
          "label": "Wave shape",
          "type": "select",
          "default": "sine",
          "choices": [
            {
              "value": "sine",
              "label": "Sine"
            },
            {
              "value": "triangle",
              "label": "Triangle"
            }
          ]
        }
      ]
    }
  ]
}
