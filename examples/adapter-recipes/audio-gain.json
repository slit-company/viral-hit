{
  "schemaVersion": 1,
  "id": "audio-gain",
  "version": "1.0.0",
  "title": "Audio gain",
  "description": "Adjust a project audio file\u2019s volume and keep up to the first 30 seconds. Produces a new WAV; the original stays in the project. Loud inputs with gain above 1 may clip.",
  "author": "Viral Hit contributors",
  "license": "Apache-2.0",
  "category": "audio",
  "parameters": [
    {
      "id": "source",
      "label": "Source audio",
      "type": "asset",
      "kind": "audio"
    },
    {
      "id": "gain",
      "label": "Volume multiplier",
      "type": "number",
      "min": 0,
      "max": 2,
      "default": 0.5
    },
    {
      "id": "duration",
      "label": "Maximum duration (seconds)",
      "type": "number",
      "min": 0.1,
      "max": 30,
      "default": 3
    }
  ],
  "nodes": [
    {
      "id": "process",
      "operation": "ext.audio-gain",
      "version": "1",
      "cache": false,
      "input": {
        "sourceAssetId": "",
        "gain": 0.5,
        "duration": 3
      },
      "parameters": [
        {
          "parameter": "source",
          "target": "/sourceAssetId"
        },
        {
          "parameter": "gain",
          "target": "/gain"
        },
        {
          "parameter": "duration",
          "target": "/duration"
        }
      ]
    },
    {
      "id": "audio",
      "operation": "asset.materialize",
      "version": "1",
      "cache": false,
      "input": {
        "receipt": null,
        "kind": "audio",
        "label": "Adjusted audio"
      },
      "dependsOn": [
        "process"
      ],
      "bindings": [
        {
          "node": "process",
          "pointer": "/binaryReceipt",
          "target": "/receipt"
        }
      ]
    }
  ]
}
